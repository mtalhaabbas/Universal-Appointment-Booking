# Environment Variables Template
DEBUG=True
SECRET_KEY=django-insecure-universal-booking-engine-secret-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Default fallback is sqlite in local dev if DB_ENGINE is sqlite or postgres connection fails
DB_ENGINE=postgresql
DB_NAME=booking_engine_db
DB_USER=booking_user
DB_PASSWORD=booking_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# WhatsApp Business Cloud API Configuration
WHATSAPP_API_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_VERIFY_TOKEN=universal_booking_verify_token_2026
WHATSAPP_MOCK_MODE=True

# Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback/
CALENDAR_MOCK_MODE=True

# n8n Automation & Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/booking-events
N8N_API_KEY=
WEBHOOK_SECRET_KEY=universal_booking_webhook_secret_2026
